# Copy to .env for local runs (.env is gitignored). Production values come from Secrets Manager / SOPS.
PORT=8080
# Operator API (adminUpdateQueue) on its own port; keep it on the private network.
# Operator tokens: EdDSA JWT from ADMIN_JWKS_URL, iss ADMIN_ISSUER, aud rusuh-queue-admin, amr with mfa.
ADMIN_PORT=8081
ADMIN_JWKS_URL=
ADMIN_ISSUER=rusuh-admin
ENV=development

DATABASE_URL=postgres://postgres:postgres@localhost:5432/rusuh?sslmode=disable

VALKEY_ADDR=localhost:6379
VALKEY_PASSWORD=

# Ed25519 signing keys: kid=base64(32-byte seed), comma-separated, signing key first.
# Empty only in development (an ephemeral key is generated). Make one with:
#   echo "$(date +%Y-%m)=$(head -c 32 /dev/urandom | base64)"
SIGNING_KEYS=

# Cloudflare Turnstile. Test secrets: 1x0000000000000000000000000000000AA passes, 2x...AA fails.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
TURNSTILE_HOSTNAMES=
ATTESTOR=sandbox

# Trust CLIENT_IP_HEADER only from these proxies (lab: Cloudflare ranges; AWS: CloudFront-Viewer-Address + VPC CIDR)
CLIENT_IP_HEADER=
TRUSTED_PROXY_CIDRS=
CORS_ORIGINS=http://localhost:3000

# core's JWKS for access tokens (account attach on join, D-4); empty = bearer tokens refused
CORE_JWKS_URL=
# registerAdmission: claims return the token only after core stored it; empty URL = off
CORE_INTERNAL_URL=
CORE_INTERNAL_TOKEN=
CORE_ADMISSION_TIMEOUT=1s
RL_JOIN_PER_DEVICE=30
# ADR-0021: claimTurn needs an access token; a device not logged in before its turn gets LOGIN_WINDOW
CLAIM_REQUIRES_LOGIN=true
LOGIN_WINDOW=3m
# D-13: how often an account may move its place (or its claimed turn, ADR-0021) to another device per event (0 = off)
PLACE_TRANSFERS_PER_EVENT=1
RL_CLAIM_PER_DEVICE=60

# Admission controller: tick, lease (order window), purge grace after a lease
# ends, the window after which an unclaimed turn is MISSED ("60 detik untuk
# masuk"; also the D-7 invitation window), and the ratePerMin window (also how
# long the history is kept; must be >= MISS_WINDOW). RATE_PRIOR_ORDER_TIME is
# the average claim-to-paid time: for that long after the first admission the
# frontier shows the guess maxSlots / RATE_PRIOR_ORDER_TIME (rateSource "prior"),
# because nobody has finished yet; 0 turns the guess off.
TICK=1s
ORDER_WINDOW=5m
PURGE_GRACE=30s
MISS_WINDOW=60s
RATE_WINDOW=5m
RATE_PRIOR_ORDER_TIME=6m
# A held booking keeps its slot until its payment deadline + HOLD_GRACE.
HOLD_GRACE=2m
# unreserved is reconciled with core:{evt}:stock on every nudge and at least
# every RECONCILE_EVERY; a snapshot older than SNAPSHOT_MAX_AGE is skipped.
RECONCILE_EVERY=10s
SNAPSHOT_MAX_AGE=30s

DEVICE_TOKEN_TTL=720h
RL_DEVICE_PER_IP=10
RL_DEVICE_PER_SUBNET=100

# Drain budget after SIGTERM; keep below the orchestrator grace period (45 s)
SHUTDOWN_TIMEOUT=30s

LOG_LEVEL=info
LOG_FORMAT=text
OTEL_EXPORTER_TYPE=stdout
# OTLP over HTTP (traces and metrics), so the collector's HTTP port 4318.
OTEL_ENDPOINT=localhost:4318
# Per-signal overrides of OTEL_EXPORTER_TYPE (otlp, stdout, none).
# Metrics every 60 s; none keeps local logs quiet, otlp sends them to the collector.
OTEL_METRICS_EXPORTER=none
# stdout prints every request span; none keeps local output readable.
OTEL_TRACES_EXPORTER=none
# none: logs stay on stdout only; otlp also ships them to the collector.
OTEL_LOGS_EXPORTER=none
# Trace sampling is read by the OTEL SDK. Unset samples everything; at peak keep about 1 %:
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.01
# One log line per HTTP request (health checks excluded); spans and HTTP metrics are recorded either way.
REQUEST_LOG=true
